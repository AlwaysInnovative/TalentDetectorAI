'use client'
import { useEffect, useState } from 'react'
import { createClient } from '@/lib/supabase/client'
import { motion } from 'framer-motion'
import { BarChart, Bar, LineChart, Line, PieChart, Pie, Cell, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, AreaChart, Area } from 'recharts'
import { Briefcase, Users, Clock, TrendingUp, Target, Download, RefreshCw } from 'lucide-react'
import useSWR from 'swr'

const fetcher = async () => {
  const supabase = createClient()
  const [jobs, candidates] = await Promise.all([
    supabase.from('jobs').select('*', { count: 'exact' }),
    supabase.from('candidates').select('*', { count: 'exact' })
  ])
  return { jobsCount: jobs.count || 0, candidatesCount: candidates.count || 0 }
}

